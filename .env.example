PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

MONGO_URI=your_mongo_uri
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Gmail account used to send password-reset OTP emails.
# GMAIL_APP_PASSWORD must be a 16-character Google App Password
# (Google Account > Security > 2-Step Verification > App passwords),
# not the account's normal login password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Sender display name for notification emails (password reset already uses GMAIL_USER/GMAIL_APP_PASSWORD above)
EMAIL_FROM_NAME=Digital Logics Studio

# Protects /api/internal/* routes. Vercel automatically sends this as a
# Bearer token when calling your Cron Job if this env var is named exactly
# CRON_SECRET — no extra Vercel config needed beyond setting it.
CRON_SECRET=replace-with-a-long-random-secret

# Shared secret for POST /api/community/xp, which the Quantum Community portal's
# contribution-worker polls to turn XP earned here into quantum points there.
# Set the same value as DLS_SYNC_SECRET on the worker. Deliberately separate
# from CRON_SECRET: this one only reads XP. Leave unset to keep the endpoint off.
COMMUNITY_SYNC_SECRET=replace-with-a-different-long-random-secret

# Notification tuning (all optional — sensible defaults shown)
MILESTONE_THRESHOLDS=5,10,25,50,100,200
DIGEST_INTERVAL_DAYS=7
INACTIVITY_THRESHOLD_DAYS=7
INACTIVITY_REMINDER_COOLDOWN_DAYS=7

# DLS Mentor AI (Groq + Pinecone RAG)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.5

PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=dls-chatbot
PINECONE_TOP_K=5
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
